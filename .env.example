# open-db-mcp configuration
# ==========================================================================
# Everything is configured here. Restart the server/container after editing.
#
# Naming rule for every database:   <TYPE>_<SOURCE-NAME>_<SETTING>=value
#   e.g. PG_CORE_HOST  ->  a Postgres source called "CORE", setting HOST.
#   <SOURCE-NAME> must NOT contain "_"  (CORE, ORDER, SALAMGATE ... are fine).
#   Two sources of different types MAY share a name (PG_X_* and REDIS_X_*).
#
# Long and short spellings are both accepted for these settings:
#   _PASSWORD    == _PASS
#   _USERNAME    == _USER
#   _DATABASE    == _DB
#   _ALLOW_WRITE == _WRITE      (true/false, yes/no, 1/0)
# ==========================================================================


# === Server ===
PORT=3000
LOG_LEVEL=info
TZ=UTC
# Browser origins allowed to call /mcp (comma-separated). Empty = no CORS.
# MCP_CORS_ORIGINS=https://app.example.com


# === Users: who may connect, and what they may do ===
# Each user = one access TOKEN (the secret put in the MCP client URL / header)
# plus one ROLE.
#
#   MCP_USER_<NAME>_TOKEN=<secret token for this user>
#   MCP_USER_<NAME>_ROLE=reader | writer | admin        (default: reader)
#
#   reader  read-only: every list/describe/query tool, no writes
#   writer  may also call db_execute_write ...
#   admin   ... same as writer (reserved for future admin tools)
#
# A WRITE ONLY HAPPENS WHEN BOTH ARE TRUE:
#   1. the user's ROLE is writer or admin, AND
#   2. the database has <TYPE>_<NAME>_ALLOW_WRITE=true (see below).
#
# Client usage:  http://localhost:3000/mcp   with header
#   Authorization: Bearer <token>     (or X-Api-Key: <token>, or ?api_key=<token>)
MCP_USER_ADMIN_TOKEN=change-me-to-a-long-random-string
MCP_USER_ADMIN_ROLE=admin
# MCP_USER_ALI_TOKEN=another-long-random-string
# MCP_USER_ALI_ROLE=reader
#
# (Older spellings still work: MCP_USER_<NAME>=<token> and
#  MCP_API_KEYS=token1:role1,token2:role2)


# === PostgreSQL ===   PG_<NAME>_*
# PG_MAIN_HOST=host.docker.internal
# PG_MAIN_PORT=5432
# PG_MAIN_USERNAME=postgres
# PG_MAIN_PASSWORD=secret
# PG_MAIN_DATABASE=main_db
# PG_MAIN_SSLMODE=prefer
# PG_MAIN_ALLOW_WRITE=false      # true = writers may run db_execute_write here


# === MySQL / MariaDB ===   MYSQL_<NAME>_*
# MYSQL_APP_HOST=host.docker.internal
# MYSQL_APP_PORT=3306
# MYSQL_APP_USERNAME=root
# MYSQL_APP_PASSWORD=secret
# MYSQL_APP_DATABASE=app_db
# MYSQL_APP_TLS=                 # "true" or "skip-verify" to enable TLS
# MYSQL_APP_ALLOW_WRITE=false


# === ClickHouse ===   CH_<NAME>_*
# CH_OLAP_HOST=host.docker.internal
# CH_OLAP_PORT=9000              # 9000 = native, 8123 = HTTP
# CH_OLAP_PROTOCOL=              # native | http  (empty = auto-detect)
# CH_OLAP_USERNAME=default
# CH_OLAP_PASSWORD=
# CH_OLAP_DATABASE=default
# CH_OLAP_SECURE=false           # true = TLS
# CH_OLAP_ALLOW_WRITE=false


# === MongoDB ===   MONGO_<NAME>_*
# Either a full URI:
# MONGO_LOGS_URI=mongodb://user:pass@host:27017/dbname
# Or individual pieces:
# MONGO_LOGS_HOST=host.docker.internal
# MONGO_LOGS_PORT=27017
# MONGO_LOGS_USERNAME=root
# MONGO_LOGS_PASSWORD=secret
# MONGO_LOGS_DATABASE=app
# MONGO_LOGS_AUTH_DB=admin


# === Redis ===   REDIS_<NAME>_*
# Either a URL:
# REDIS_CACHE_URL=redis://:password@host:6379/0
# Or pieces:
# REDIS_CACHE_HOST=host.docker.internal
# REDIS_CACHE_PORT=6379
# REDIS_CACHE_PASSWORD=
# REDIS_CACHE_DATABASE=0


# === SQLite ===   SQLITE_<NAME>_*
# SQLITE_LOCAL_PATH=/data/app.db
# SQLITE_LOCAL_ALLOW_WRITE=false


# === Elasticsearch ===   ES_<NAME>_*
# ES_LOGS_URL=https://elastic.example.com:9200
# ES_LOGS_API_KEY=BASE64_ID_AND_KEY        # preferred
# ES_LOGS_USERNAME=elastic                 # alternative to API key
# ES_LOGS_PASSWORD=secret
# ES_LOGS_INSECURE_TLS=false
# A read-only ES user (no cluster "monitor" privilege) is fine: connection
# checks tolerate 403 and es_list_indices falls back to _resolve/index.


# === CLOG log search (optional — enables clog_* tools) ===
# Point CLOG_ES_SOURCE at the <NAME> of one ES_<NAME>_* source above.
# CLOG_ES_SOURCE=LOGS
# CLOG_INGRESS_INDEX=logs-ingress-*
# CLOG_LOGS_PREFIX=logs-
# CLOG_ALL_LOGS_INDEX=logs-*
#
# Optional field-name overrides (first field present wins):
# CLOG_NAMESPACE_FIELDS=kubernetes.namespace,k8s.namespace
# CLOG_CONTAINER_FIELDS=kubernetes.container_name,container.name
# CLOG_SERVICE_FIELDS=kubernetes.pod_labels.app,service.name
# CLOG_INGRESS_STATUS_FIELDS=status,http.status_code
# CLOG_INGRESS_LATENCY_FIELDS=request_time,latency,duration
# CLOG_INGRESS_HOST_FIELDS=host,http.host
# CLOG_INGRESS_PATH_FIELDS=path,uri,url.path
# CLOG_POD_FIELDS=kubernetes.pod_name
# CLOG_TIME_FIELD=@timestamp
# CLOG_MESSAGE_FIELD=message
# Text fields are matched through their .keyword sub-field automatically.
# Log messages returned by clog_* tools have tokens/passwords masked.


# === search_tables synonyms (optional) ===
# canonical:variant|variant;canonical2:... — works in both directions.
# SEARCH_SYNONYMS=vendor:seller|booth|shop;customer:user|buyer|client;order:sale|invoice
